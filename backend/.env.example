# Copy to .env to override. Everything here is optional; these are the defaults.

# HTTP + WebSocket port. The firmware connects to 3000 (SERVER_PORT in firmware/config.h),
# so change both together.
PORT=3000

# Name the server answers on the local network. Must match SERVER_MDNS_NAME in
# firmware/config.h (without ".local").
MDNS_HOST=led-server.local

# Set to "off" to skip mDNS (tests do this, so they don't answer the real ESP32).
MDNS=on

# Where alarms.json and tones/ are stored, relative to backend/.
DATA_DIR=.

# Time zone for devices that haven't been given one (IANA name). Defaults to this
# machine's zone, which is right for a local server; set it on a cloud server (UTC).
# TZ_DEFAULT=Asia/Dhaka

# MQTT broker the devices connect to (EMQX Cloud). Leave MQTT_URL unset to use
# only the old direct WebSocket connection for devices.
# MQTT_URL=mqtts://uf91663e.ala.asia-southeast1.emqxsl.com:8883
# MQTT_USERNAME=server
# MQTT_PASSWORD=

# Address devices use to download tones and firmware. Defaults to this machine's
# LAN address (http://192.168.x.x:3000); set it when the server runs elsewhere.
# PUBLIC_URL=https://speaker.example.com
